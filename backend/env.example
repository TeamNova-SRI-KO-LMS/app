# SRI-KO LMS Backend - Environment Configuration Template
# Copy this file to config.env and update with your actual values

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration - MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/SriKo?retryWrites=true&w=majority&appName=Cluster0

# Frontend URL Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Security Configuration
SESSION_SECRET=your-session-secret-key-here
JWT_SECRET=your-jwt-secret-key-here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# OAuth callback/redirect URL (if using authorization code / redirect flow)
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback
# Optional: scopes to request from Google (comma separated or space separated)
GOOGLE_SCOPE=openid email profile

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
FRONTEND_URL=http://localhost:3000