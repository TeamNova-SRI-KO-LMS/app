# SRI-KO LMS Backend - Environment Configuration Template
# Local development: copy this file to backend/.env and fill in your values.
# Vercel: add each variable under Project → Settings → Environment Variables.

# Server Configuration (PORT is ignored on Vercel)
NODE_ENV=development
PORT=5000

# Database Configuration - MongoDB Atlas
# On Vercel, allow access from anywhere (0.0.0.0/0) in Atlas → Network Access.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/SriKo?retryWrites=true&w=majority&appName=Cluster0

# Allowed frontend origin(s) for CORS and Socket.IO. Comma-separated; a "*" matches
# Vercel preview URLs, e.g. https://sri-ko.vercel.app,https://sri-ko-*-team.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional extra origins, same format as FRONTEND_URL
CORS_ORIGIN=

# Authentication (JWT) - use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRE=7d

# Google OAuth 2.0 (Sign in with Google) - same client ID as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your-google-client-id-here

# Stripe card payments - secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Course materials & assignment uploads (Google Drive)
# Use EITHER an OAuth refresh token (uploads use that Google account's quota; it
# also needs GOOGLE_CLIENT_ID above) OR a service account. Without working Drive
# credentials, uploads fall back to the local uploads/ folder - which is not
# possible on Vercel, so configure Drive for deployments.
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Drive folder IDs per file type
GDRIVE_FOLDER_THUMBNAILS=
GDRIVE_FOLDER_VIDEOS=
GDRIVE_FOLDER_PDFS=
GDRIVE_FOLDER_IMAGES=
GDRIVE_FOLDER_ASSIGNMENTS=
# Public URL of this backend, used to build links for locally stored uploads
BACKEND_URL=http://localhost:5000

# Password reset email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com
