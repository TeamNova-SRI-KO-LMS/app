{
  "name": "teamnova-sri-ko-lms",
  "version": "1.0.0",
  "description": "Backend for the LMS project",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage --ci --json --outputFile=coverage/test-results.json",
    "test:node": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "seed:demo": "node tests/fixtures/seedDemoData.js",
    "test:perf": "node tests/performance/loadTest.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.1.0",
    "googleapis": "^186.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "socket.io": "^4.8.4",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^30.5.2",
    "mongodb-memory-server-core": "^10.4.3",
    "nodemon": "^1.14.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.2.2"
  }
}
