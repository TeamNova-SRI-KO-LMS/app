# SRI-KO LMS Frontend - Environment Configuration Template
# Local development: copy this file to frontend/.env and fill in your values.
# Vercel: add each variable under Project → Settings → Environment Variables,
# then redeploy (Vite bakes VITE_* values into the build).

# Backend API URL including the /api prefix. Locally its port must match PORT in
# backend/.env; on Vercel use the backend project's URL, e.g.
# https://sri-ko-backend.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Real-time notifications over Socket.IO. Set to false when the backend runs on
# Vercel: notifications then refresh automatically every minute instead.
VITE_ENABLE_SOCKET=true

# Google OAuth 2.0 (Sign in with Google) - same client ID as the backend's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Stripe card payments - publishable key (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Supabase Storage for course and announcement images
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: default bucket name (defaults to "courses")
VITE_SUPABASE_BUCKET=courses
